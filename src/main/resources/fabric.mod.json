{
	"schemaVersion": 1,
	"id": "codegenie",
	"version": "${version}",
	"name": "Code Genie",
	"description": "A retro cheat cartridge for Minecraft, inspired by the classic NES Game Genie. Punch in famous 8-bit codes like SXIOPO and get a Minecraft version of the original cheat.",
	"authors": [
		"Code Genie contributors"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/codegenie"
	},
	"license": "MIT",
	"icon": "assets/codegenie/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.codegenie.CodeGenie"
		],
		"client": [
			"dev.codegenie.client.CodeGenieClient"
		]
	},
	"mixins": [
		{
			"config": "codegenie.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
